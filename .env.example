# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── Backend toggle ────────────────────────────────────────────────────────────
# Set to true to use real camera, YOLO model, and SQLite database.
# false (default) keeps the mock backend — app runs without any hardware.
USE_REAL_BACKEND=false

# ── Camera (rubukk/pcb — see CAMERA_SETUP.md) ────────────────────────────────
# Built-in webcam (default):
CAMERA_SOURCE=0
# DroidCam via Wi-Fi (replace with the IP shown in the DroidCam app):
# CAMERA_SOURCE=http://192.168.1.x:4747/video
# DroidCam via USB (usually device index 1 when built-in webcam is 0):
# CAMERA_SOURCE=1

# ── YOLO model (rubukk/pcb — copy model/best.pt here) ────────────────────────
# Copy model/best.pt from the rubukk/pcb repo into the models/ folder,
# or point this to any absolute path.
YOLO_MODEL_PATH=models/best.pt
